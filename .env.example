# ============================================================
# Spike Agent — environment configuration
# Copy to .env and fill in. All values can also be set as
# environment variables (they override the .env file).
# ============================================================

# Your Deriv API app — create a PAT-type app at https://developers.deriv.com
# (Dashboard -> Register application -> type: PAT). This is NOT the legacy
# app_id from app.deriv.com — legacy IDs do not work with the new API.
DERIV_APP_ID=

# Personal Access Token from the developers.deriv.com Dashboard
# (Dashboard -> API tokens -> Create PAT, scopes: trade, account_manage).
# Shown once at creation — store it securely. Used only to fetch a
# short-lived WebSocket OTP; it is never sent to the browser.
DERIV_PAT=

# Password that protects this app's dashboard. Anyone with this password
# (from any device) can view status and start/stop the agent.
ACCESS_PASSWORD=changeme

# Starting virtual balance used in paper-trading mode (demo play money).
PAPER_BALANCE=1000

# Bind address/port inside the container.
HOST=0.0.0.0
PORT=8000

# Where SQLite + learned model weights live. Mount this as a volume in
# the cloud so learning survives restarts/redeploys.
DATA_DIR=./data
